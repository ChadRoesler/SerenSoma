# ════════════════════════════════════════════════════════════════════════
#  seren-soma.yaml - copy to ~/seren-soma/seren-soma.yaml
# ════════════════════════════════════════════════════════════════════════

server:
  host: 0.0.0.0            # the robot dials in over the LAN
  port: 7480
  # The API token. Blank: the file `token` in the state folder, made the first time.
  # bearer_token_env: SEREN_SOMA_TOKEN

# Tokens, what was heard, touches, settings and the log. Outside any repo.
state_dir: ~/seren-soma/state

# This box's address as the robot reaches it. Blank: the address this box uses toward the robot.
# advertise: 192.0.2.10

# voice: ""               # the voice Lodestar speaks in; blank: Lodestar's default
idle_close_seconds: 60     # an open channel with no words this long hangs up

robot:
  url: http://192.0.2.21:8080   # required: the robot's control API (its screen shows the address)
  # Its control token (token: in the robot's soma.yaml). Blank: the file
  # `control_token` in the state folder. Or token_env / token_keyring / token_file / token.
  # The check-in only answers the robot's own address; add others if it reaches you through one:
  # device_from: [192.0.2.21]

lodestar:
  # Hearing and speaking. Blank url: read from the Symposium config on this box.
  # url: http://192.0.2.10:6361
  # token_env: SEREN_LODESTAR_TOKEN
  # Or: read the url and bearer from a Symposium config on this box. One of the two is required.
  # symposium_yaml: ~/seren/<instance>/apps/symposium/seren-symposium.yaml
